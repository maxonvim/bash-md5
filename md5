		F=((B^(A|~C))+D+1126891415+m7)&4294967295, D=(A+(F<<10|F>>22))&4294967295,
		F=((A^(D|~B))+C+2878612391+m14)&4294967295, C=(D+(F<<15|F>>17))&4294967295,
		F=((D^(C|~A))+B+4237533241+m5)&4294967295, B=(C+(F<<21|F>>11))&4294967295,
