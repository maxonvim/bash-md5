		F=(((A&C)|(~A&D))+B+3921069994+m0)&4294967295, B=(C+(F<<20|F>>12))&4294967295,
		F=(((D&B)|(~D&C))+A+3593408605+m5)&4294967295, A=(B+(F<<5|F>>27))&4294967295,
		F=(((C&A)|(~C&B))+D+38016083+m10)&4294967295, D=(A+(F<<9|F>>23))&4294967295,
		F=(((B&D)|(~B&A))+C+3634488961+m15)&4294967295, C=(D+(F<<14|F>>18))&4294967295,
		F=(((A&C)|(~A&D))+B+3889429448+m4)&4294967295, B=(C+(F<<20|F>>12))&4294967295,
		F=(((D&B)|(~D&C))+A+568446438+m9)&4294967295, A=(B+(F<<5|F>>27))&4294967295,
		F=(((C&A)|(~C&B))+D+3275163606+m14)&4294967295, D=(A+(F<<9|F>>23))&4294967295,
		F=(((B&D)|(~B&A))+C+4107603335+m3)&4294967295, C=(D+(F<<14|F>>18))&4294967295,
		F=(((A&C)|(~A&D))+B+1163531501+m8)&4294967295, B=(C+(F<<20|F>>12))&4294967295,
		F=(((D&B)|(~D&C))+A+2850285829+m13)&4294967295, A=(B+(F<<5|F>>27))&4294967295,
