		F=((C^D^A)+B+3200236656+m10)&4294967295, B=(C+(F<<23|F>>9))&4294967295,
		F=((B^C^D)+A+681279174+m13)&4294967295, A=(B+(F<<4|F>>28))&4294967295,
		F=((A^B^C)+D+3936430074+m0)&4294967295, D=(A+(F<<11|F>>21))&4294967295,
		F=((D^A^B)+C+3572445317+m3)&4294967295, C=(D+(F<<16|F>>16))&4294967295,
		F=((C^D^A)+B+76029189+m6)&4294967295, B=(C+(F<<23|F>>9))&4294967295,
		F=((B^C^D)+A+3654602809+m9)&4294967295, A=(B+(F<<4|F>>28))&4294967295,
		F=((A^B^C)+D+3873151461+m12)&4294967295, D=(A+(F<<11|F>>21))&4294967295,
