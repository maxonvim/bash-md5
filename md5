		F=((C^(B|~D))+A+1873313359+m8)&4294967295, A=(B+(F<<6|F>>26))&4294967295,
		F=((B^(A|~C))+D+4264355552+m15)&4294967295, D=(A+(F<<10|F>>22))&4294967295,
		F=((A^(D|~B))+C+2734768916+m6)&4294967295, C=(D+(F<<15|F>>17))&4294967295,
		F=((D^(C|~A))+B+1309151649+m13)&4294967295, B=(C+(F<<21|F>>11))&4294967295,
		F=((C^(B|~D))+A+4149444226+m4)&4294967295, A=(B+(F<<6|F>>26))&4294967295,
		F=((B^(A|~C))+D+3174756917+m11)&4294967295, D=(A+(F<<10|F>>22))&4294967295,
		F=((A^(D|~B))+C+718787259+m2)&4294967295, C=(D+(F<<15|F>>17))&4294967295,
		F=((D^(C|~A))+B+3951481745+m9)&4294967295, B=(C+(F<<21|F>>11))&4294967295,

		a0=(a0+A)&4294967295, b0=(b0+B)&4294967295,
		c0=(c0+C)&4294967295, d0=(d0+D)&4294967295,
		1
	))
}

# This path only handles a partial block (after NUL or EOF), so clarity here
# costs nothing in the full-block hot path.
load-buffer-block() {
	local o=$1
	((
		m0=buffer[o]|buffer[o+1]<<8|buffer[o+2]<<16|buffer[o+3]<<24,
		m1=buffer[o+4]|buffer[o+5]<<8|buffer[o+6]<<16|buffer[o+7]<<24,
		m2=buffer[o+8]|buffer[o+9]<<8|buffer[o+10]<<16|buffer[o+11]<<24,
		m3=buffer[o+12]|buffer[o+13]<<8|buffer[o+14]<<16|buffer[o+15]<<24,
		m4=buffer[o+16]|buffer[o+17]<<8|buffer[o+18]<<16|buffer[o+19]<<24,
		m5=buffer[o+20]|buffer[o+21]<<8|buffer[o+22]<<16|buffer[o+23]<<24,
		m6=buffer[o+24]|buffer[o+25]<<8|buffer[o+26]<<16|buffer[o+27]<<24,
		m7=buffer[o+28]|buffer[o+29]<<8|buffer[o+30]<<16|buffer[o+31]<<24,
		m8=buffer[o+32]|buffer[o+33]<<8|buffer[o+34]<<16|buffer[o+35]<<24,
		m9=buffer[o+36]|buffer[o+37]<<8|buffer[o+38]<<16|buffer[o+39]<<24,
		m10=buffer[o+40]|buffer[o+41]<<8|buffer[o+42]<<16|buffer[o+43]<<24,
		m11=buffer[o+44]|buffer[o+45]<<8|buffer[o+46]<<16|buffer[o+47]<<24,
		m12=buffer[o+48]|buffer[o+49]<<8|buffer[o+50]<<16|buffer[o+51]<<24,
		m13=buffer[o+52]|buffer[o+53]<<8|buffer[o+54]<<16|buffer[o+55]<<24,
		m14=buffer[o+56]|buffer[o+57]<<8|buffer[o+58]<<16|buffer[o+59]<<24,
		m15=buffer[o+60]|buffer[o+61]<<8|buffer[o+62]<<16|buffer[o+63]<<24
	))
	process-block
}

process-input() {
	local chunk code n pos blk bytes c o low_bits high_bits
	local -a buffer=()

	while true; do
		IFS= read -r -d '' -n 4096 chunk
		code=$?
		n=${#chunk}
		pos=0
		debug "read $n bytes (code=$code)"

		if ((n)); then
			((byte_count += n))

			while ((${#buffer[@]} && ${#buffer[@]} < 64 && pos < n)); do
				printf -v c '%d' "'${chunk:pos++:1}"
				buffer+=("$c")
			done
			if ((${#buffer[@]} == 64)); then
				load-buffer-block 0
				buffer=()
			fi

			while ((pos + 64 <= n)); do
				blk=${chunk:pos:64}
				((pos += 64))
				# shellcheck disable=SC2089
				printf -v bytes '%d ' \
					"'${blk:0:1}"  "'${blk:1:1}"  "'${blk:2:1}"  "'${blk:3:1}" \
					"'${blk:4:1}"  "'${blk:5:1}"  "'${blk:6:1}"  "'${blk:7:1}" \
					"'${blk:8:1}"  "'${blk:9:1}"  "'${blk:10:1}" "'${blk:11:1}" \
					"'${blk:12:1}" "'${blk:13:1}" "'${blk:14:1}" "'${blk:15:1}" \
					"'${blk:16:1}" "'${blk:17:1}" "'${blk:18:1}" "'${blk:19:1}" \
					"'${blk:20:1}" "'${blk:21:1}" "'${blk:22:1}" "'${blk:23:1}" \
					"'${blk:24:1}" "'${blk:25:1}" "'${blk:26:1}" "'${blk:27:1}" \
					"'${blk:28:1}" "'${blk:29:1}" "'${blk:30:1}" "'${blk:31:1}" \
					"'${blk:32:1}" "'${blk:33:1}" "'${blk:34:1}" "'${blk:35:1}" \
					"'${blk:36:1}" "'${blk:37:1}" "'${blk:38:1}" "'${blk:39:1}" \
					"'${blk:40:1}" "'${blk:41:1}" "'${blk:42:1}" "'${blk:43:1}" \
					"'${blk:44:1}" "'${blk:45:1}" "'${blk:46:1}" "'${blk:47:1}" \
					"'${blk:48:1}" "'${blk:49:1}" "'${blk:50:1}" "'${blk:51:1}" \
					"'${blk:52:1}" "'${blk:53:1}" "'${blk:54:1}" "'${blk:55:1}" \
					"'${blk:56:1}" "'${blk:57:1}" "'${blk:58:1}" "'${blk:59:1}" \
					"'${blk:60:1}" "'${blk:61:1}" "'${blk:62:1}" "'${blk:63:1}"
				# Intentional splitting of the decimal-only printf output.
				# shellcheck disable=SC2086,SC2090
				set -- $bytes
				((
					m0=$1|$2<<8|$3<<16|$4<<24, m1=$5|$6<<8|$7<<16|$8<<24,
					m2=$9|${10}<<8|${11}<<16|${12}<<24, m3=${13}|${14}<<8|${15}<<16|${16}<<24,
					m4=${17}|${18}<<8|${19}<<16|${20}<<24, m5=${21}|${22}<<8|${23}<<16|${24}<<24,
					m6=${25}|${26}<<8|${27}<<16|${28}<<24, m7=${29}|${30}<<8|${31}<<16|${32}<<24,
					m8=${33}|${34}<<8|${35}<<16|${36}<<24, m9=${37}|${38}<<8|${39}<<16|${40}<<24,
					m10=${41}|${42}<<8|${43}<<16|${44}<<24, m11=${45}|${46}<<8|${47}<<16|${48}<<24,
					m12=${49}|${50}<<8|${51}<<16|${52}<<24, m13=${53}|${54}<<8|${55}<<16|${56}<<24,
					m14=${57}|${58}<<8|${59}<<16|${60}<<24, m15=${61}|${62}<<8|${63}<<16|${64}<<24
				))
				process-block
			done

			while ((pos < n)); do
				printf -v c '%d' "'${chunk:pos++:1}"
				buffer+=("$c")
			done
		fi

		if ((code == 0 && n < 4096)); then
			buffer+=(0)
			((byte_count++))
			if ((${#buffer[@]} == 64)); then
				load-buffer-block 0
				buffer=()
			fi
		fi

		((code != 0)) && break
	done

	buffer+=(128)
	while (((${#buffer[@]} & 63) != 56)); do
		buffer+=(0)
	done

	low_bits=$(((byte_count << 3) & 4294967295))
	high_bits=$(((byte_count >> 29) & 4294967295))
	buffer+=(
		$((low_bits & 255)) $((low_bits >> 8 & 255))
		$((low_bits >> 16 & 255)) $((low_bits >> 24 & 255))
		$((high_bits & 255)) $((high_bits >> 8 & 255))
		$((high_bits >> 16 & 255)) $((high_bits >> 24 & 255))
	)

	for ((o=0; o<${#buffer[@]}; o+=64)); do
		load-buffer-block "$o"
	done
}

print-hash() {
	printf '%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x\n' \
		$((a0 & 255)) $((a0 >> 8 & 255)) $((a0 >> 16 & 255)) $((a0 >> 24 & 255)) \
		$((b0 & 255)) $((b0 >> 8 & 255)) $((b0 >> 16 & 255)) $((b0 >> 24 & 255)) \
		$((c0 & 255)) $((c0 >> 8 & 255)) $((c0 >> 16 & 255)) $((c0 >> 24 & 255)) \
		$((d0 & 255)) $((d0 >> 8 & 255)) $((d0 >> 16 & 255)) $((d0 >> 24 & 255))
}

main() {
	if [[ -n $1 ]]; then
		debug "reading data from file: $1"
		process-input < "$1" || return 1
	else
		debug 'reading data from stdin'
		process-input
	fi
	print-hash
}

main "$@"
