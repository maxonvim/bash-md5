#!/usr/bin/env bash
#
# Pure Bash implementation of MD5, optimized for throughput.
#
# Usage:
#   ./md5 file.txt
#   ./md5 < file.bin
#
# Author: Dave Eddy <ysap@daveeddy.com>
# Contributors: barkermn01, qjtdsqqm94akkyysgjdqo3hx1jn6l17,
#               Guiorgy, ghoul-the-legend
