LC_ALL=C

# Bash cannot store NUL bytes in variables. read therefore uses NUL as its
# delimiter and each successful short read contributes the omitted NUL.

a0=1732584193
b0=4023233417
c0=2562383102
d0=271733878
byte_count=0

m0=0 m1=0 m2=0 m3=0 m4=0 m5=0 m6=0 m7=0
m8=0 m9=0 m10=0 m11=0 m12=0 m13=0 m14=0 m15=0
A=0 B=0 C=0 D=0 F=0

debug-func() {
	printf '[DEBUG] %s\n' "$*" >&2
}

shopt -s expand_aliases
if [[ -n $DEBUG ]]; then
	alias debug=debug-func
else
	alias debug='#'
fi

# The message words are scalars and all 64 rounds are one arithmetic command.
# Cycling A/D/C/B eliminates register-shuffle assignments between rounds.
process-block() {
	((
		A=a0, B=b0, C=c0, D=d0,

		F=(((B&C)|(~B&D))+A+3614090360+m0)&4294967295, A=(B+(F<<7|F>>25))&4294967295,
		F=(((A&B)|(~A&C))+D+3905402710+m1)&4294967295, D=(A+(F<<12|F>>20))&4294967295,
		F=(((D&A)|(~D&B))+C+606105819+m2)&4294967295, C=(D+(F<<17|F>>15))&4294967295,
		F=(((C&D)|(~C&A))+B+3250441966+m3)&4294967295, B=(C+(F<<22|F>>10))&4294967295,
		F=(((B&C)|(~B&D))+A+4118548399+m4)&4294967295, A=(B+(F<<7|F>>25))&4294967295,
		F=(((A&B)|(~A&C))+D+1200080426+m5)&4294967295, D=(A+(F<<12|F>>20))&4294967295,
		F=(((D&A)|(~D&B))+C+2821735955+m6)&4294967295, C=(D+(F<<17|F>>15))&4294967295,
		F=(((C&D)|(~C&A))+B+4249261313+m7)&4294967295, B=(C+(F<<22|F>>10))&4294967295,
		F=(((B&C)|(~B&D))+A+1770035416+m8)&4294967295, A=(B+(F<<7|F>>25))&4294967295,
		F=(((A&B)|(~A&C))+D+2336552879+m9)&4294967295, D=(A+(F<<12|F>>20))&4294967295,
		F=(((D&A)|(~D&B))+C+4294925233+m10)&4294967295, C=(D+(F<<17|F>>15))&4294967295,
		F=(((C&D)|(~C&A))+B+2304563134+m11)&4294967295, B=(C+(F<<22|F>>10))&4294967295,
		F=(((B&C)|(~B&D))+A+1804603682+m12)&4294967295, A=(B+(F<<7|F>>25))&4294967295,
		F=(((A&B)|(~A&C))+D+4254626195+m13)&4294967295, D=(A+(F<<12|F>>20))&4294967295,
		F=(((D&A)|(~D&B))+C+2792965006+m14)&4294967295, C=(D+(F<<17|F>>15))&4294967295,
